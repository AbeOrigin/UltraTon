{
  "name": "ultraton",
  "version": "2.4.1",
  "type": "module",
  "description": "Ultra safe HTTP client for critical environments in Node.js",
  "homepage": "https://abeorigin.github.io/UltraTon/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbeOrigin/UltraTon.git"
  },
  "bugs": {
    "url": "https://github.com/AbeOrigin/UltraTon/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"import('node:fs').then(f=>f.rmSync('dist',{recursive:true,force:true,maxRetries:3,retryDelay:100}))\" && tsc",
    "build:strict": "tsc --noEmit --strict",
    "test": "node --import ./__tests__/fixtures/loopback-only.ts --test \"__tests__/**/*.test.ts\"",
    "test:package": "node scripts/smoke-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run test:package",
    "lint:package": "publint --strict && attw --pack . --profile esm-only",
    "check:tsdoc": "node scripts/check-tsdoc.mjs",
    "check:api": "node scripts/check-api.mjs",
    "demo:http2:server": "node demo/http2.server.ts",
    "demo:http2:client": "node demo/http2.client.ts",
    "demo:server": "node demo/server.ts",
    "demo:client": "node demo/client.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "^22",
    "publint": "0.3.25",
    "typescript": "~7.0.2"
  }
}
